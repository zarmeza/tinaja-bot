DISCORD_BOT_TOKEN=

# The local engine behind tinaja-bot's conversations (Ollama). No secrets: safe defaults.
# TINAJA_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
# TINAJA_LLM_MODEL=qwen2.5:3b
# Channel ids where tinaja-bot also converses uninvited, comma-separated. Unset: mentions only.
# TINAJA_CHAT_CHANNELS=1234567890123456789
# The web lamps behind "what he doesn't know" answer with no keys at all: dolarapi.com (dólar/euro
# of Venezuela), Open-Meteo (the sky of Mérida), Google News RSS and then Bing RSS. Optional gains:
#   Your own SearXNG jumps ahead of the public feeds when it stands (JSON format required)
#   TINAJA_SEARX_URL=http://127.0.0.1:8080
#   Brave Search answers ahead of the feeds while its key stands (free tier, 2000 consultations a month)
#   TINAJA_BRAVE_API_KEY=
#   The corner whose sky the bot answers for (Mérida by birth)
#   TINAJA_HOME_LAT=8.6047
#   TINAJA_HOME_LON=-71.1476
